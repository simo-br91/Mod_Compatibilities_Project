APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080
GATEWAY_HTTP_PORT=8080
EVIDENCE_HTTP_PORT=8081
ADMIN_HTTP_PORT=8082
RECOMMENDATION_HTTP_PORT=8083
GRAPH_HTTP_PORT=8084
SIMULATION_HTTP_PORT=8085
ORCHESTRATOR_HTTP_PORT=8086
ARTIFACT_ANALYSIS_JAVA_SOURCE=apps/artifact-analysis/src/main/java/com/modcompat/artifactanalysis/ArtifactAnalysisBoundary.java
API_BASE_URL=http://localhost:8080
EVIDENCE_SERVICE_URL=http://localhost:8081
ADMIN_SERVICE_URL=http://localhost:8082
RECOMMENDATION_SERVICE_URL=http://localhost:8083
GRAPH_SERVICE_URL=http://localhost:8084
SIMULATION_SERVICE_URL=http://localhost:8085
ORCHESTRATOR_SERVICE_URL=http://localhost:8086
WEB_BASE_URL=http://localhost:3000
JAVA_BIN=java
# Point this at the shared/remote Postgres instance you want the offline and
# ground-truth pipelines to persist to by default. Use --allow-ephemeral only
# when you intentionally want a local non-persistent run.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/modcompat
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword
OPENSEARCH_URL=http://localhost:9200
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_RAW=modcompat-raw
S3_BUCKET_ARTIFACTS=modcompat-artifacts
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
TENANT_DEFAULT_ORG_ID=org_localdev
ALLOW_DEMO_AUTH=true

# Ground-truth execution pipeline
# Use a prepared local Forge server directory as a template. The runner copies it
# into an isolated workdir, downloads the target mod jars, starts the server,
# waits for the "Done" line, and then records the result in Postgres.
GROUND_TRUTH_FORGE_TEMPLATE_DIR=
GROUND_TRUTH_FORGE_VERSION=47.4.20
# Add entries only when you also have matching runtime templates, for example:
# GROUND_TRUTH_FORGE_VERSION_BY_MINECRAFT=1.20.1=47.4.20,1.21.1=52.1.0
GROUND_TRUTH_FORGE_VERSION_BY_MINECRAFT=
# Leave blank to auto-detect:
# - Windows -> cmd /c run.bat nogui
# - Linux   -> sh ./run.sh nogui
GROUND_TRUTH_FORGE_LAUNCH_COMMAND=
GROUND_TRUTH_MOD_CACHE_DIR=.ground-truth-cache/mods
GROUND_TRUTH_CONCURRENCY=1
GROUND_TRUTH_RANDOM_FORGE_MOD_POOL=balm,bookshelf,collective,curios,architectury-api,placebo,ferritecore,modernfix
GROUND_TRUTH_TIMEOUT_MS=900000
GROUND_TRUTH_FORGE_READY_GRACE_MS=8000

# Workspace + billing service
WORKSPACE_HTTP_PORT=8090
WORKSPACE_SERVICE_URL=http://localhost:8090

# OAuth/OIDC configuration (required when ALLOW_DEMO_AUTH=false)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=

# Stripe billing (leave blank to use plan_default / self-hosted mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
