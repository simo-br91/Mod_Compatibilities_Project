HTTP_PORT=8080
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
WORKSPACE_SERVICE_BASE_URL=http://localhost:8081
CATALOG_SERVICE_BASE_URL=http://localhost:8082
ANALYSIS_ORCHESTRATOR_BASE_URL=http://localhost:8083

# OAuth/OIDC configuration (required for real authentication; omit for demo-session fallback)
OIDC_ISSUER_URL=https://your-oidc-provider.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
JWT_SECRET=change-this-to-a-random-256-bit-secret-in-production

