{
  "title": "ModCompat Staging Overview",
  "uid": "modcompat-staging-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": ["modcompat", "staging", "phase13"],
  "panels": [
    {
      "id": 1,
      "title": "Latest Canary Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "modcompat_canary_overall_success{environment=\"staging\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Canary Freshness",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "time() - modcompat_canary_run_timestamp_seconds{environment=\"staging\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Probe Success By Step",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "modcompat_canary_success{environment=\"staging\"}",
          "legendFormat": "{{probe}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Probe Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "modcompat_canary_duration_milliseconds{environment=\"staging\"}",
          "legendFormat": "{{probe}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Blackbox Service Health",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "probe_success{job=\"modcompat-staging-healthz\", environment=\"staging\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ]
}
