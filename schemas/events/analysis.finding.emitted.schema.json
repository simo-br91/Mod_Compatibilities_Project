{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modcompat.dev/schemas/events/analysis.finding.emitted.schema.json",
  "title": "analysis.finding.emitted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "trace_id",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "analysis.finding.emitted" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "organization_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "project_id": { "type": "string" },
    "producer": { "type": "string" },
    "payload": {
      "allOf": [
        {
          "$ref": "../json/finding.schema.json"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_id",
            "finding_id",
            "type",
            "severity",
            "confidence",
            "reproducibility",
            "title",
            "subjects"
          ],
          "properties": {
            "analysis_id": { "type": "string" },
            "dedupe_key": { "type": "string" }
          }
        }
      ]
    }
  }
}
